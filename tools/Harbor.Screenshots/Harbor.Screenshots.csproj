<Project Sdk="Microsoft.NET.Sdk">
  <!-- Captures the documentation screenshots from the real app on Windows (CI: .github/workflows/screenshots.yml).
       Not shipped. See README.md and ADR-0031. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Harbor.Screenshots</RootNamespace>
    <!-- WPF Fluent theme (ThemeMode) is flagged experimental; the app reference pulls it in. -->
    <NoWarn>$(NoWarn);WPF0001;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Harbor.App\Harbor.App.csproj" />
  </ItemGroup>
</Project>
