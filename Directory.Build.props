<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Allows building Windows-only projects (WPF, Win32 interop) on Linux/macOS CI agents. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Company>Remote Desktop Harbor</Company>
    <Product>Remote Desktop Harbor</Product>
    <Copyright>Copyright (c) 2026 Bartosz Kuriata</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
    <!-- Symbols inside the binaries: release folders contain only the exe. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <!-- Analyzer rules that are noise for this codebase. -->
    <NoWarn>$(NoWarn);CA1848;CA1716;CA1031;CA2007;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1062;CA1819;CA1515;CA1711;CA1032;CA1063;CA1816;CA1805;CA1822;CA1869;CA2000;CA1001</NoWarn>
  </PropertyGroup>
</Project>
