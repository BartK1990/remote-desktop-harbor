<!-- The app's message box (SPEC FR-53, ADR-0030): same title bar, colours and fonts as the rest of the app instead of
     the system MessageBox. A risky confirmation makes the safe button the default, so Enter never confirms by accident. -->
<Window x:Class="Harbor.App.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Harbor.App.Views"
        Width="480" SizeToContent="Height" Icon="/Assets/AppIcon.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary Source="/Themes/Controls.xaml" />
  </Window.Resources>
  <StackPanel>
    <views:TitleBar ShowMinimizeMaximize="False" />
    <Grid Margin="20,8,20,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="IconBadge" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top" Margin="0,2,14,0">
        <TextBlock x:Name="IconGlyph" FontFamily="{StaticResource Harbor.IconFont}" FontSize="16" HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <!-- Selectable, so a message (an error, who is connected) can be copied. -->
        <TextBox x:Name="Message" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,6,0,0"
                 TextWrapping="Wrap" MaxHeight="320" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Message" />
      </StackPanel>
    </Grid>
    <Border Margin="0,20,0,0" Padding="20,14" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ConfirmButton" MinWidth="110" Margin="0,0,8,0" Click="Confirm_Click" />
        <Button x:Name="CancelButton" MinWidth="110" IsCancel="True" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
