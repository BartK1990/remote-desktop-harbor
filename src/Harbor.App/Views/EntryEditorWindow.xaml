<ui:FluentWindow x:Class="Harbor.App.Views.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}" Width="560" Height="720" MinHeight="480"
        Icon="/Assets/AppIcon.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMinimize="False" ShowMaximize="False" />
    <DockPanel Grid.Row="1" Margin="16,4,16,16">
      <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Import .rdp…" Command="{Binding ImportRdpFileCommand}" Margin="0,0,24,0" />
          <ui:Button Content="Save" IsDefault="True" Click="Save_Click" Appearance="Primary" MinWidth="90" Margin="0,0,8,0" />
          <Button Content="Cancel" IsCancel="True" MinWidth="90" />
        </StackPanel>
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Type" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
          <StackPanel Orientation="Horizontal">
            <RadioButton Content="RDP connection" IsChecked="{Binding IsRdpConnection}" Margin="0,0,16,0"
                         ToolTip="Stores the full Remote Desktop profile (.rdp settings) plus credentials." />
            <RadioButton Content="Credentials only" IsChecked="{Binding IsCredentialOnly}"
                         ToolTip="Stores only user name and password (and optional host); RDP uses default settings." />
          </StackPanel>

          <TextBlock Text="Name *" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="Folder" Style="{StaticResource FieldLabel}" />
          <ComboBox IsEditable="True" ItemsSource="{Binding Folders}" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Host" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Domain" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="User name" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>

          <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
          <CheckBox Content="Change stored password" IsChecked="{Binding ChangePassword}" Margin="0,0,0,6"
                    Visibility="{Binding HadPassword, Converter={StaticResource BoolToVisibility}}" />
          <ui:PasswordBox x:Name="PasswordBox" IsEnabled="{Binding ChangePassword}" PasswordChanged="PasswordBox_PasswordChanged" />
          <TextBlock Text="Leave empty to store no password. Passwords are encrypted before they are written." Style="{StaticResource Hint}" Margin="0,4,0,0" />

          <!-- Additional accounts (SPEC FR-09). -->
          <TextBlock Text="Additional accounts" Style="{StaticResource FieldLabel}" />
          <TextBlock Text="For hosts that allow several sessions at once, such as Windows Server. Each account is listed under the entry; an empty domain uses the domain above."
                     Style="{StaticResource Hint}" />
          <ItemsControl ItemsSource="{Binding Accounts}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,6,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Domain" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="User name *" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>
                      <Button Grid.Column="3" Content="Remove" Margin="8,0,0,0" VerticalAlignment="Bottom"
                              Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                    </Grid>
                    <TextBlock Text="Password" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,2" />
                    <CheckBox Content="Change stored password" IsChecked="{Binding ChangePassword}" Margin="0,0,0,6"
                              Visibility="{Binding HadPassword, Converter={StaticResource BoolToVisibility}}" />
                    <ui:PasswordBox IsEnabled="{Binding ChangePassword}" PasswordChanged="AccountPasswordBox_PasswordChanged" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Add account" Command="{Binding AddAccountCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />

          <StackPanel Visibility="{Binding IsRdpConnection, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="RDP settings (.rdp lines, key:type:value)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding RdpSettings, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono, Consolas" MinHeight="110" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
          </StackPanel>

          <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</ui:FluentWindow>
