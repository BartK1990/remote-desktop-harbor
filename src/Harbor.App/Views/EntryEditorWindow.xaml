<Window x:Class="Harbor.App.Views.EntryEditorWindow"
        Background="{DynamicResource Harbor.WindowBackgroundBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Harbor.App.Views"
        Title="{Binding Title}" Width="820" Height="620" MinWidth="680" MinHeight="460"
        Icon="/Assets/AppIcon.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
  <!-- Own title bar with Close only (SPEC FR-52, ADR-0029). -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.InputBindings>
    <KeyBinding Key="S" Modifiers="Ctrl" Command="ApplicationCommands.Save" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed" />
  </Window.CommandBindings>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- SPEC FR-46, ADR-0024: the Fluent scroll bar overlays the content, so every tab page keeps a right gutter for it. -->
      <Style x:Key="TabPage" TargetType="StackPanel">
        <Setter Property="Margin" Value="4,0,20,12" />
      </Style>
      <Style x:Key="TabScroller" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      </Style>
      <Style x:Key="SmallLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,2" />
      </Style>
      <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
      </Style>
      <!-- The RDP tabs are only shown for an RDP connection. -->
      <Style x:Key="RdpTab" TargetType="TabItem" BasedOn="{StaticResource Harbor.NavTab}">
        <Setter Property="Visibility" Value="{Binding IsRdpConnection, Converter={StaticResource BoolToVisibility}}" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel>
  <views:TitleBar DockPanel.Dock="Top" ShowMinimizeMaximize="False" />
  <DockPanel Margin="16,8,16,16">
    <!-- Footer: the problem that blocks saving on the left, actions on the right (SPEC FR-46). -->
    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Error}" Style="{StaticResource Harbor.Text.Error}" VerticalAlignment="Center" Margin="0,0,16,0" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="Import .rdp…" Command="{Binding ImportRdpFileCommand}" Style="{StaticResource Harbor.SubtleButton}" Margin="0,0,16,0" />
        <Button IsDefault="True" Click="Save_Click" Style="{DynamicResource AccentButtonStyle}" MinWidth="90" Margin="0,0,8,0" ToolTip="Save (Ctrl+S or Enter)">Save</Button>
        <Button Content="Cancel" IsCancel="True" MinWidth="90" ToolTip="Cancel (Esc)" />
      </StackPanel>
    </Grid>

    <!-- SPEC FR-46, ADR-0024, ADR-0027: the editor is split into tabs, drawn as a side navigation. -->
    <TabControl x:Name="Tabs" Style="{StaticResource Harbor.NavTabControl}">
      <TabItem Header="General">
        <ScrollViewer Style="{StaticResource TabScroller}">
          <StackPanel Style="{StaticResource TabPage}">
            <TextBlock Text="Type" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal" AutomationProperties.Name="Entry type">
              <RadioButton GroupName="Kind" Style="{StaticResource Harbor.Segment}" Content="RDP connection" IsChecked="{Binding IsRdpConnection}"
                           ToolTip="Stores the full Remote Desktop profile (.rdp settings) plus credentials." />
              <RadioButton GroupName="Kind" Style="{StaticResource Harbor.Segment}" Content="Credentials only" IsChecked="{Binding IsCredentialOnly}"
                           ToolTip="Stores only user name and password (and optional host); RDP uses default settings." />
            </StackPanel>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Name *" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Name" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Folder" Style="{StaticResource FieldLabel}" />
                <ComboBox IsEditable="True" ItemsSource="{Binding Folders}" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"
                          FontFamily="{StaticResource Harbor.MonoFont}" AutomationProperties.Name="Folder"
                          ToolTip="Use / for sub-folders, e.g. Production/Web." />
              </StackPanel>
            </Grid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="90" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Host" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="HostBox" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Harbor.MonoTextBox}"
                         AutomationProperties.Name="Host" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="PortBox" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Harbor.MonoTextBox}"
                         AutomationProperties.Name="Port" />
              </StackPanel>
            </Grid>
            <TextBlock Text="A pasted host:port is split into Host and Port when you save." Style="{StaticResource Hint}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Domain" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Harbor.MonoTextBox}" AutomationProperties.Name="Domain" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="User name" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Harbor.MonoTextBox}" AutomationProperties.Name="User name"
                         ToolTip="DOMAIN\user is split into Domain and User name when Domain is empty; user@domain is kept as typed." />
              </StackPanel>
            </Grid>

            <!-- Password: kept, replaced or removed explicitly instead of a "change" checkbox (SPEC FR-46). -->
            <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
            <Border Padding="12,4,4,4" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="{Binding ShowStoredPassword, Converter={StaticResource BoolToVisibility}}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="Replace…" Command="{Binding ReplacePasswordCommand}" Style="{StaticResource Harbor.Button}" Click="ReplacePassword_Click" />
                  <Button Content="Remove" Command="{Binding RemovePasswordCommand}" Style="{StaticResource Harbor.SubtleButton}" Margin="0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Harbor.Text.Icon}" Text="&#xE72E;" Margin="0,0,8,0" />
                <TextBlock Text="Stored, encrypted" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </DockPanel>
            </Border>
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowStoredPassword}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Keep stored password" Command="{Binding KeepPasswordCommand}" Style="{StaticResource Harbor.SubtleButton}"
                        Margin="8,0,0,0" Visibility="{Binding HadPassword, Converter={StaticResource BoolToVisibility}}" />
                <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" AutomationProperties.Name="Password" />
              </DockPanel>
              <TextBlock>
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                    <Setter Property="Text" Value="Leave empty to store no password. Passwords are encrypted before they are written." />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding PasswordRemovalPending}" Value="True">
                        <Setter Property="Text" Value="The stored password is removed when you save. Type a new one to replace it instead." />
                        <Setter Property="Foreground" Value="{DynamicResource Harbor.OfflineTextBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>

            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="60" MaxHeight="160" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Notes" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Additional accounts (SPEC FR-09). -->
      <TabItem Header="Accounts">
        <ScrollViewer Style="{StaticResource TabScroller}">
          <StackPanel Style="{StaticResource TabPage}">
            <TextBlock Text="For hosts that allow several sessions at once, such as Windows Server. The domain, user name and password on the General tab are the default account; each account here is listed under the entry. An empty domain uses the entry's domain."
                       Style="{StaticResource Hint}" Margin="0" />
            <ItemsControl ItemsSource="{Binding Accounts}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.7*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Domain" Style="{StaticResource SmallLabel}" />
                        <TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Harbor.MonoTextBox}" AutomationProperties.Name="Account domain" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="User name *" Style="{StaticResource SmallLabel}" />
                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Harbor.MonoTextBox}" AutomationProperties.Name="Account user name" />
                      </StackPanel>
                      <StackPanel Grid.Column="4">
                        <TextBlock Text="Password" Style="{StaticResource SmallLabel}" />
                        <!-- Stored: Replace; otherwise the box (with Keep when there was one). SPEC FR-46 -->
                        <DockPanel Visibility="{Binding ShowStoredPassword, Converter={StaticResource BoolToVisibility}}" MinHeight="32">
                          <Button DockPanel.Dock="Right" Content="Replace…" Command="{Binding ReplacePasswordCommand}" Style="{StaticResource Harbor.Button}" Margin="0" />
                          <TextBlock Text="Stored" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     ToolTip="A password is stored for this account, encrypted." TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <DockPanel Visibility="{Binding ChangePassword, Converter={StaticResource BoolToVisibility}}">
                          <Button DockPanel.Dock="Right" Command="{Binding KeepPasswordCommand}" Style="{StaticResource Harbor.SubtleButton}" Margin="4,0,0,0" Padding="8,5"
                                  ToolTip="Keep the stored password" AutomationProperties.Name="Keep stored password"
                                  Visibility="{Binding HadPassword, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Harbor.Text.Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="&#xE7A7;" />
                          </Button>
                          <PasswordBox PasswordChanged="AccountPasswordBox_PasswordChanged" IsVisibleChanged="AccountPasswordBox_IsVisibleChanged"
                                       AutomationProperties.Name="Account password" />
                        </DockPanel>
                      </StackPanel>
                      <Button Grid.Column="5" Content="Remove" Margin="8,0,0,0" VerticalAlignment="Bottom" Style="{StaticResource Harbor.SubtleButton}"
                              Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add account" Command="{Binding AddAccountCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- SPEC FR-13, ADR-0022: common .rdp settings as a form; other lines stay as text. -->
      <TabItem Header="Display" Style="{StaticResource RdpTab}">
        <ScrollViewer Style="{StaticResource TabScroller}">
          <StackPanel Style="{StaticResource TabPage}" DataContext="{Binding RdpSettings}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Mode" Style="{StaticResource SmallLabel}" />
                <ComboBox ItemsSource="{Binding DisplayModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding DisplayMode}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Resolution" Style="{StaticResource SmallLabel}" />
                <ComboBox ItemsSource="{Binding Resolutions}" DisplayMemberPath="Label" SelectedItem="{Binding Resolution}"
                          ToolTip="Size of the remote desktop. &quot;Match local screen&quot; uses the size of your screen (or window)." />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                        Visibility="{Binding IsCustomResolution, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Width" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox Text="{Binding CustomWidth, UpdateSourceTrigger=PropertyChanged}" Width="80" />
              <TextBlock Text="Height" VerticalAlignment="Center" Margin="16,0,6,0" />
              <TextBox Text="{Binding CustomHeight, UpdateSourceTrigger=PropertyChanged}" Width="80" />
              <TextBlock Text="pixels" VerticalAlignment="Center" Opacity="0.6" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock Text="Colour depth" Style="{StaticResource SmallLabel}" Margin="0,8,0,2" />
            <ComboBox ItemsSource="{Binding ColorDepths}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding ColorDepth}" Width="260" HorizontalAlignment="Left" />
            <CheckBox Content="Use all my monitors" IsChecked="{Binding UseAllMonitors}" Margin="0,8,0,0" />
            <CheckBox Content="Update the remote resolution when the window is resized" IsChecked="{Binding DynamicResolution}" />
            <CheckBox Content="Scale the remote desktop to fit the window (smart sizing)" IsChecked="{Binding SmartSizing}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Local resources" Style="{StaticResource RdpTab}">
        <ScrollViewer Style="{StaticResource TabScroller}">
          <StackPanel Style="{StaticResource TabPage}" DataContext="{Binding RdpSettings}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Remote audio" Style="{StaticResource SmallLabel}" />
                <ComboBox ItemsSource="{Binding AudioModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Audio}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Apply Windows key combinations" Style="{StaticResource SmallLabel}" />
                <ComboBox ItemsSource="{Binding KeyboardModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Keyboard}" ToolTip="Where shortcuts such as Alt+Tab go." />
              </StackPanel>
            </Grid>
            <CheckBox Content="Record audio from this computer (microphone)" IsChecked="{Binding RecordAudio}" Margin="0,8,0,0" />
            <TextBlock Text="Use on the remote computer" Style="{StaticResource SmallLabel}" Margin="0,12,0,2" />
            <WrapPanel>
              <CheckBox Content="Clipboard" IsChecked="{Binding RedirectClipboard}" Margin="0,0,16,0" />
              <CheckBox Content="Printers" IsChecked="{Binding RedirectPrinters}" Margin="0,0,16,0" />
              <CheckBox Content="Smart cards" IsChecked="{Binding RedirectSmartCards}" Margin="0,0,16,0" />
              <CheckBox Content="All local drives" IsChecked="{Binding RedirectDrives}" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Connection" Style="{StaticResource RdpTab}">
        <ScrollViewer Style="{StaticResource TabScroller}">
          <StackPanel Style="{StaticResource TabPage}" DataContext="{Binding RdpSettings}">
            <TextBlock Text="If server authentication fails" Style="{StaticResource SmallLabel}" />
            <ComboBox ItemsSource="{Binding ServerAuthentications}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding ServerAuthentication}" Width="260" HorizontalAlignment="Left" />
            <CheckBox Content="Reconnect automatically if the connection drops" IsChecked="{Binding AutoReconnect}" Margin="0,8,0,0" />
            <CheckBox Content="Connect to the administrative (console) session" IsChecked="{Binding AdminSession}" />

            <Expander Header="Other .rdp settings (advanced)" IsExpanded="{Binding ShowOtherSettings}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Settings the form does not cover, as .rdp lines (key:type:value), e.g. gatewayhostname:s:gw.contoso.com."
                           Style="{StaticResource Hint}" Margin="0,4,0,4" />
                <TextBox Text="{Binding OtherSettings, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="{StaticResource Harbor.MonoFont}" MinHeight="80" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
  </DockPanel>
</Window>
