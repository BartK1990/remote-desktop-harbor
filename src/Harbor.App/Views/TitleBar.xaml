<!-- The app's own title bar (SPEC FR-52, ADR-0029): 32 px, theme-aware, with optional centre and right content and
     Fluent caption buttons. The window keeps the system's resizing, snapping, shadow and system menu via WindowChrome. -->
<UserControl x:Class="Harbor.App.Views.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Height="32" Focusable="False">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Image Source="/Assets/AppIcon.ico" Width="16" Height="16" Margin="12,0,10,0" VerticalAlignment="Center"
           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Remote Desktop Harbor" />
    <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
               FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" Margin="0,0,16,0">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
          <Style.Triggers>
            <!-- Inactive windows dim their title, like the system title bar. -->
            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
    <ContentPresenter Grid.Column="2" Content="{Binding CenterContent, ElementName=Root}" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      WindowChrome.IsHitTestVisibleInChrome="True" />
    <ContentPresenter Grid.Column="3" Content="{Binding RightContent, ElementName=Root}" VerticalAlignment="Center" Margin="12,0,8,0"
                      WindowChrome.IsHitTestVisibleInChrome="True" />
    <StackPanel Grid.Column="4" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
      <Button x:Name="MinimizeButton" Style="{StaticResource Harbor.CaptionButton}" Content="&#xE921;" Click="Minimize_Click"
              ToolTip="Minimize" AutomationProperties.Name="Minimize" />
      <Button x:Name="MaximizeButton" Style="{StaticResource Harbor.CaptionButton}" Content="&#xE922;" Click="Maximize_Click"
              ToolTip="Maximize" AutomationProperties.Name="Maximize" />
      <Button Style="{StaticResource Harbor.CaptionCloseButton}" Content="&#xE8BB;" Click="Close_Click"
              ToolTip="Close" AutomationProperties.Name="Close" />
    </StackPanel>
  </Grid>
</UserControl>
