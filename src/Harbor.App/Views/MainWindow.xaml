<Window x:Class="Harbor.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Harbor.App.ViewModels"
        Title="Remote Desktop Harbor" Width="1100" Height="700" MinWidth="720" MinHeight="420"
        Icon="/Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ResourceDictionary Source="/Themes/Controls.xaml" />
  </Window.Resources>
  <!-- Keyboard first (SPEC FR-47, ADR-0026): every action has a shortcut, shown next to it or in its tooltip. -->
  <Window.InputBindings>
    <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddCommand}" />
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Key="F2" Command="{Binding EditCommand}" />
    <KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding CopyPasswordCommand}" />
    <KeyBinding Key="U" Modifiers="Ctrl+Shift" Command="{Binding CopyUserNameCommand}" />
    <KeyBinding Key="H" Modifiers="Ctrl+Shift" Command="{Binding CopyHostCommand}" />
  </Window.InputBindings>

  <DockPanel>
    <!-- Toolbar: search, icon buttons, signed-in user and settings (SPEC FR-47); the theme is in Settings (FR-08). -->
    <Grid DockPanel.Dock="Top" Margin="12,10,12,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="460" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="32,0,56,0"
                 ToolTip="Filter by name, host, user, folder or notes (Ctrl+K or Ctrl+F, Esc clears, Down moves to the list)"
                 VerticalContentAlignment="Center" AutomationProperties.Name="Search connections"
                 PreviewKeyDown="SearchBox_PreviewKeyDown">
          <TextBox.InputBindings>
            <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <TextBlock Style="{StaticResource Harbor.Text.Icon}" Text="&#xE721;" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
        <TextBlock Text="Search name, host, user…" Margin="33,0,56,0" TextTrimming="CharacterEllipsis">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Harbor.Text.Placeholder}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Style="{StaticResource Harbor.Text.KeyHint}" Text="Ctrl+K" HorizontalAlignment="Right" Margin="0,0,10,0" IsHitTestVisible="False" />
      </Grid>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
        <Button Style="{StaticResource Harbor.Button}" Command="{Binding AddCommand}" ToolTip="New entry (Ctrl+N)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Harbor.Text.Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="&#xE710;" Margin="0,0,6,0" />
            <TextBlock Text="New" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource Harbor.Button}" Command="{Binding ImportRdpCommand}" ToolTip="Create an entry from an .rdp file">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Harbor.Text.Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="&#xE8B5;" Margin="0,0,6,0" />
            <TextBlock Text="Import .rdp…" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource Harbor.Button}" Command="{Binding RefreshCommand}" ToolTip="Sync and refresh presence (F5)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Harbor.Text.Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="&#xE72C;" Margin="0,0,6,0" />
            <TextBlock Text="Refresh" />
            <TextBlock Style="{StaticResource Harbor.Text.KeyHint}" Text="F5" />
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource Harbor.Text.Icon}" Text="&#xE77B;" Margin="0,0,6,0" />
        <TextBlock Text="{Binding UserText}" ToolTip="{Binding UserText}" MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="Signed in as" />
        <Button Style="{StaticResource Harbor.SubtleButton}" Command="{Binding OpenSettingsCommand}" Margin="8,0,0,0" Padding="8,5"
                ToolTip="Settings" AutomationProperties.Name="Settings">
          <TextBlock Style="{StaticResource Harbor.Text.Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="15" Text="&#xE713;" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Status bar: what happened last, how many entries are in use, and where the data lives (SPEC FR-47). -->
    <Border DockPanel.Dock="Bottom" Padding="12,5" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
      <DockPanel TextBlock.FontSize="12">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Ellipse Margin="0,0,6,0" Visibility="{Binding IsRemote, Converter={StaticResource BoolToVisibility}}">
            <Ellipse.Style>
              <Style TargetType="Ellipse" BasedOn="{StaticResource Harbor.StatusDot}">
                <Setter Property="Fill" Value="{DynamicResource Harbor.OnlineBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsOffline}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Harbor.OfflineTextBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding StoreText}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsOffline}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Harbor.OfflineTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding InUseText}" Margin="0,0,16,0" Foreground="{DynamicResource Harbor.InUseTextBrush}" />
        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
      </DockPanel>
    </Border>

    <Grid Margin="12,4,12,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="280" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="3*" MinWidth="300" />
      </Grid.ColumnDefinitions>

      <!-- Entry tree: compact rows, collapsible folders, filtered by the search box (SPEC FR-02).
           Virtualized for large catalogs (SPEC NFR-03).
           Sits on a card (theme-aware fill + stroke) so the explorer area stands out from the window. -->
      <Border Grid.Column="0" CornerRadius="6" BorderThickness="1" Padding="2"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <TreeView x:Name="EntryTree" ItemsSource="{Binding Tree}" Background="Transparent" BorderThickness="0"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                Padding="2" SelectedItemChanged="EntryTree_SelectedItemChanged" TreeViewItem.Selected="EntryTree_ItemSelected"
                PreviewMouseDoubleClick="EntryTree_PreviewMouseDoubleClick" KeyDown="EntryTree_KeyDown"
                PreviewMouseRightButtonDown="EntryTree_PreviewMouseRightButtonDown">
        <TreeView.Resources>
          <!-- Expand/collapse chevron. -->
          <Style x:Key="TreeChevron" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent">
                    <Path x:Name="Glyph" Data="M 0,0 L 3.5,3.5 L 0,7" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" RenderTransformOrigin="0.5,0.5" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Glyph" Property="RenderTransform">
                        <Setter.Value>
                          <RotateTransform Angle="90" />
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <!-- Row content (SPEC FR-02, ADR-0025): icon, name and, for entries, the host in monospace on the right.
               An entry or account in use shows a dot and who is connected instead of the host (SPEC FR-33). -->
          <HierarchicalDataTemplate DataType="{x:Type vm:FolderViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
              <TextBlock Style="{StaticResource Harbor.Text.Icon}" Text="&#xE8B7;" Margin="0,0,6,0" />
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Count}" Margin="6,0,0,0" FontSize="{StaticResource Harbor.FontSize.Caption}" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
          </HierarchicalDataTemplate>

          <!-- An entry with several accounts has one child row per account (SPEC FR-09). -->
          <HierarchicalDataTemplate DataType="{x:Type vm:EntryViewModel}" ItemsSource="{Binding Children}">
            <Grid ToolTip="{Binding Subtitle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Margin="0,0,6,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Harbor.Text.Icon}">
                    <Setter Property="Text" Value="&#xE7F4;" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCredentialOnly}" Value="True">
                        <Setter Property="Text" Value="&#xE8D7;" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Address}" Margin="10,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Harbor.Text.MonoSecondary}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsInUse}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" MaxWidth="200" ToolTip="{Binding PresenceDetails}"
                          Visibility="{Binding IsInUse, Converter={StaticResource BoolToVisibility}}"
                          AutomationProperties.Name="{Binding PresenceText}">
                <Ellipse Style="{StaticResource Harbor.StatusDot}" />
                <TextBlock Style="{StaticResource Harbor.Text.Presence}" Text="{Binding PresenceName}" />
              </StackPanel>
            </Grid>
          </HierarchicalDataTemplate>

          <DataTemplate DataType="{x:Type vm:AccountViewModel}">
            <Grid ToolTip="Connect or copy with this account">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Harbor.Text.Icon}" Text="&#xE77B;" FontSize="{StaticResource Harbor.FontSize.Mono}" Margin="0,0,6,0" />
              <TextBlock Grid.Column="1" Style="{StaticResource Harbor.Text.Mono}" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" MaxWidth="200" ToolTip="{Binding PresenceDetails}"
                          Visibility="{Binding IsInUse, Converter={StaticResource BoolToVisibility}}"
                          AutomationProperties.Name="{Binding PresenceText}">
                <Ellipse Style="{StaticResource Harbor.StatusDot}" />
                <TextBlock Style="{StaticResource Harbor.Text.Presence}" Text="{Binding PresenceName}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </TreeView.Resources>

        <TreeView.ItemContainerStyle>
          <!-- Compact rows: one line (Harbor.TreeRowHeight), 16 px indent per level. -->
          <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="Row" Background="Transparent" MinHeight="{StaticResource Harbor.TreeRowHeight}">
                      <Border x:Name="Fill" CornerRadius="3" Background="{TemplateBinding Foreground}" Opacity="0" />
                      <Border x:Name="Bar" Width="3" Height="12" CornerRadius="1.5" HorizontalAlignment="Left" Visibility="Collapsed"
                              Background="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="16" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="Expander" Style="{StaticResource TreeChevron}" Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" />
                        <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" Margin="2,0,6,0"
                                          VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                      </Grid>
                    </Grid>
                    <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="16,0,0,0" />
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="HasItems" Value="False">
                      <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                    </Trigger>
                    <Trigger Property="IsExpanded" Value="False">
                      <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                    </Trigger>
                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                      <Setter TargetName="Fill" Property="Opacity" Value="0.06" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Fill" Property="Opacity" Value="0.1" />
                      <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <Trigger Property="VirtualizingPanel.IsVirtualizing" Value="True">
                <Setter Property="ItemsPanel">
                  <Setter.Value>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </Style.Triggers>
          </Style>
        </TreeView.ItemContainerStyle>

        <TreeView.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Connect" Command="{Binding ConnectCommand}" InputGestureText="Enter" />
            <MenuItem Header="Copy password" Command="{Binding CopyPasswordCommand}" InputGestureText="Ctrl+Shift+C" />
            <MenuItem Header="Copy user" Command="{Binding CopyUserNameCommand}" />
            <MenuItem Header="Edit" Command="{Binding EditCommand}" />
            <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
            <Separator />
            <MenuItem Header="Expand all" Command="{Binding ExpandAllCommand}" />
            <MenuItem Header="Collapse all" Command="{Binding CollapseAllCommand}" />
          </ContextMenu>
        </TreeView.ContextMenu>
      </TreeView>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

      <!-- Details (SPEC FR-47, ADR-0026): header, actions with their shortcuts, active sessions, then cards. -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="16,0,8,0">
        <Grid>
          <StackPanel Margin="0,8">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="No entry selected" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20">
              <Run Text="Type in the search box (" /><Run Text="Ctrl+K" FontFamily="{StaticResource Harbor.MonoFont}" /><Run Text="), press " /><Run Text="↓" FontFamily="{StaticResource Harbor.MonoFont}" /><Run Text=" and " /><Run Text="Enter" FontFamily="{StaticResource Harbor.MonoFont}" /><Run Text=" to connect." />
              <LineBreak />
              <Run Text="Create an entry with New (" /><Run Text="Ctrl+N" FontFamily="{StaticResource Harbor.MonoFont}" /><Run Text=") or Import .rdp…" />
            </TextBlock>
          </StackPanel>

          <StackPanel DataContext="{Binding Selected}">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>

            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
              <Run Text="{Binding GroupName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding KindLabel, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
            <TextBox Text="{Binding Address, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                     FontFamily="{StaticResource Harbor.MonoFont}" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                     AutomationProperties.Name="Host" Margin="0,2,0,0">
              <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Address}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBox.Style>
            </TextBox>

            <WrapPanel Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
              <!-- Connect names the account it uses; the arrow picks another account of the entry (SPEC FR-09). -->
              <StackPanel Orientation="Horizontal" Margin="0,0,6,6">
                <Button Content="{Binding ConnectText}" Command="{Binding ConnectCommand}" Style="{DynamicResource AccentButtonStyle}"
                        Padding="16,6" ToolTip="Open in Remote Desktop (Enter / double-click)" />
                <Button x:Name="AccountsButton" Click="AccountsButton_Click" Padding="8,6" Margin="2,0,0,0" Style="{DynamicResource AccentButtonStyle}"
                        ToolTip="Connect with another account" AutomationProperties.Name="Choose account"
                        Visibility="{Binding Selected.HasAccounts, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock FontFamily="{StaticResource Harbor.IconFont}" FontSize="10" Text="&#xE70D;" VerticalAlignment="Center" />
                </Button>
              </StackPanel>
              <!-- Long shortcuts go in the tooltip so the row fits the default window width. -->
              <Button Style="{StaticResource Harbor.Button}" Command="{Binding CopyPasswordCommand}" Margin="0,0,6,6"
                      ToolTip="Copy password (Ctrl+Shift+C); cleared from the clipboard after 30 s">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Harbor.Text.Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="&#xE8C8;" Margin="0,0,6,0" />
                  <TextBlock Text="Copy password" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource Harbor.Button}" Command="{Binding CopyUserNameCommand}" Margin="0,0,6,6" ToolTip="Copy user (Ctrl+Shift+U)">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Harbor.Text.Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="&#xE8C8;" Margin="0,0,6,0" />
                  <TextBlock Text="Copy user" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource Harbor.Button}" Command="{Binding EditCommand}" Margin="0,0,6,6" ToolTip="Edit (F2)">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Edit" /><TextBlock Style="{StaticResource Harbor.Text.KeyHint}" Text="F2" /></StackPanel>
              </Button>
              <Button x:Name="MoreButton" Style="{StaticResource Harbor.SubtleButton}" Click="MoreButton_Click" Margin="0,0,6,6" Padding="9,5"
                      ToolTip="More actions" AutomationProperties.Name="More actions">
                <TextBlock Style="{StaticResource Harbor.Text.Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="&#xE712;" />
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy host" Command="{Binding CopyHostCommand}" InputGestureText="Ctrl+Shift+H" />
                    <Separator />
                    <MenuItem Header="Delete…" Command="{Binding DeleteCommand}" InputGestureText="Del" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </WrapPanel>

            <!-- Active sessions: one row each, and whether connecting would take one over (SPEC FR-33). -->
            <Border Margin="0,10,0,0" Padding="12,8,12,10" CornerRadius="6" Background="{DynamicResource Harbor.InUseBackgroundBrush}"
                    Visibility="{Binding IsInUse, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Grid.IsSharedSizeScope="True">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Style="{StaticResource Harbor.StatusDot}" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding SessionsHeader}" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="{Binding DataContext.TakeoverWarning, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap"
                           Margin="15,2,0,6" FontSize="12" />
                <Grid Margin="15,0,0,2" TextBlock.FontSize="11" TextBlock.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Who" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Account" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Machine" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="User" Margin="0,0,18,0" />
                  <TextBlock Grid.Column="1" Text="Account" Margin="0,0,18,0" />
                  <TextBlock Grid.Column="2" Text="Machine" Margin="0,0,18,0" />
                  <TextBlock Grid.Column="3" Text="Since" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Sessions}" Margin="15,0,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SessionRow}">
                      <Grid Margin="0,3,0,0" ToolTip="{Binding Email}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" SharedSizeGroup="Who" />
                          <ColumnDefinition Width="Auto" SharedSizeGroup="Account" />
                          <ColumnDefinition Width="Auto" SharedSizeGroup="Machine" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Who}" Margin="0,0,18,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Account}" Style="{StaticResource Harbor.Text.Mono}" Margin="0,0,18,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Machine}" Style="{StaticResource Harbor.Text.Mono}" Margin="0,0,18,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Since}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Connection: host, port and the account Connect and Copy use (SPEC FR-09), each with a copy button. -->
            <Border Style="{StaticResource Harbor.Card}">
              <StackPanel>
                <TextBlock Text="CONNECTION" Style="{StaticResource Harbor.Text.Caption}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource Harbor.KeyColumnWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Host" Style="{StaticResource Harbor.Text.Key}" />
                  <TextBox Grid.Column="1" Text="{Binding Model.Host, Mode=OneWay, TargetNullValue='—'}" IsReadOnly="True" BorderThickness="0"
                           Background="Transparent" Padding="0" VerticalAlignment="Center" FontFamily="{StaticResource Harbor.MonoFont}" FontSize="13"
                           AutomationProperties.Name="Host" />
                  <Button Grid.Column="2" Style="{StaticResource Harbor.CopyButton}" ToolTip="Copy host (Ctrl+Shift+H)" AutomationProperties.Name="Copy host"
                          Command="{Binding DataContext.CopyHostCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                  <TextBlock Grid.Row="1" Text="Port" Style="{StaticResource Harbor.Text.Key}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Model.Port}" Style="{StaticResource Harbor.Text.Mono}" FontSize="13" VerticalAlignment="Center" />

                  <TextBlock Grid.Row="2" Text="User" Style="{StaticResource Harbor.Text.Key}" />
                  <TextBox Grid.Row="2" Grid.Column="1" DataContext="{Binding DataContext.SelectedAccount, RelativeSource={RelativeSource AncestorType=Window}}"
                           Text="{Binding QualifiedUserName, Mode=OneWay, TargetNullValue='—'}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                           Padding="0" VerticalAlignment="Center" FontFamily="{StaticResource Harbor.MonoFont}" FontSize="13" AutomationProperties.Name="User" />
                  <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource Harbor.CopyButton}" ToolTip="Copy user (Ctrl+Shift+U)" AutomationProperties.Name="Copy user"
                          Command="{Binding DataContext.CopyUserNameCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                  <TextBlock Grid.Row="3" Text="Password" Style="{StaticResource Harbor.Text.Key}" />
                  <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             DataContext="{Binding DataContext.SelectedAccount, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Not stored" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasPassword}" Value="True">
                            <Setter Property="Text" Value="•••••••• encrypted" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource Harbor.CopyButton}" ToolTip="Copy password (Ctrl+Shift+C); cleared after 30 s"
                          AutomationProperties.Name="Copy password"
                          Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Grid>
                <TextBlock Text="Several accounts: expand the entry in the list, or use the arrow next to Connect, to connect or copy with another one."
                           FontSize="{StaticResource Harbor.FontSize.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Margin="0,6,0,0" Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </Border>

            <!-- RDP profile: how the connection opens, without opening the editor (SPEC FR-47). -->
            <Border>
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Harbor.Card}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCredentialOnly}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel>
                <TextBlock Text="RDP PROFILE" Style="{StaticResource Harbor.Text.Caption}" />
                <ItemsControl ItemsSource="{Binding RdpSummary}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="{StaticResource Harbor.KeyColumnWidth}" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Harbor.Text.Key}" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Harbor.Text.Mono}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Harbor.Card}" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="NOTES" Style="{StaticResource Harbor.Text.Caption}" />
                <TextBox Text="{Binding Model.Notes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                         Padding="0" AutomationProperties.Name="Notes" />
              </StackPanel>
            </Border>

            <TextBlock FontSize="{StaticResource Harbor.FontSize.Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,12,0,8"
                       TextWrapping="Wrap">
              <Run Text="Changed by" />
              <Run Text="{Binding Model.UpdatedBy, Mode=OneWay, TargetNullValue='—'}" FontFamily="{StaticResource Harbor.MonoFont}" />
              <Run Text="·" />
              <Run Text="{Binding Model.UpdatedUtc.LocalDateTime, Mode=OneWay, StringFormat='g'}" />
              <Run Text="· version" />
              <Run Text="{Binding Model.Version, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
