<Window x:Class="Harbor.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Harbor.App.ViewModels"
        Title="Remote Desktop Harbor" Width="1100" Height="700" MinWidth="720" MinHeight="420"
        Icon="/Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen">
  <Window.InputBindings>
    <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddCommand}" />
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding CopyPasswordCommand}" />
  </Window.InputBindings>

  <DockPanel>
    <!-- Toolbar -->
    <Grid DockPanel.Dock="Top" Margin="12,12,12,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="420" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Filter by name, host, user, folder or notes (Ctrl+F, Esc clears, Down moves to the list)" VerticalContentAlignment="Center"
               PreviewKeyDown="SearchBox_PreviewKeyDown">
        <TextBox.InputBindings>
          <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
        </TextBox.InputBindings>
      </TextBox>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
        <Button Content="New" Command="{Binding AddCommand}" Margin="0,0,6,0" ToolTip="New entry (Ctrl+N)" />
        <Button Content="Import .rdp…" Command="{Binding ImportRdpCommand}" Margin="0,0,6,0" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,6,0" ToolTip="Sync and refresh (F5)" />
        <Button Content="Settings" Command="{Binding OpenSettingsCommand}" />
      </StackPanel>
      <TextBlock Grid.Column="3" Text="{Binding UserText}" VerticalAlignment="Center" Opacity="0.8" />
    </Grid>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="12,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding StoreText}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsOffline}" Value="True">
                  <Setter Property="Foreground" Value="OrangeRed" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid Margin="12,6,12,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="280" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="3*" MinWidth="300" />
      </Grid.ColumnDefinitions>

      <!-- Entry tree: compact rows, collapsible folders, filtered by the search box (SPEC FR-02).
           Virtualized for large catalogs (SPEC NFR-03).
           Sits on a card (theme-aware fill + stroke) so the explorer area stands out from the window. -->
      <Border Grid.Column="0" CornerRadius="6" BorderThickness="1" Padding="2"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <TreeView x:Name="EntryTree" ItemsSource="{Binding Tree}" Background="Transparent" BorderThickness="0"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                Padding="2" SelectedItemChanged="EntryTree_SelectedItemChanged" TreeViewItem.Selected="EntryTree_ItemSelected"
                MouseDoubleClick="EntryTree_MouseDoubleClick" KeyDown="EntryTree_KeyDown"
                PreviewMouseRightButtonDown="EntryTree_PreviewMouseRightButtonDown">
        <TreeView.Resources>
          <!-- Expand/collapse chevron. -->
          <Style x:Key="TreeChevron" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent">
                    <Path x:Name="Glyph" Data="M 0,0 L 3.5,3.5 L 0,7" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" RenderTransformOrigin="0.5,0.5" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Glyph" Property="RenderTransform">
                        <Setter.Value>
                          <RotateTransform Angle="90" />
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <HierarchicalDataTemplate DataType="{x:Type vm:FolderViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Count}" Margin="6,0,0,0" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
            </StackPanel>
          </HierarchicalDataTemplate>

          <DataTemplate DataType="{x:Type vm:EntryViewModel}">
            <Grid ToolTip="{Binding Subtitle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Border Grid.Column="1" Background="#33FF8C00" CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center"
                      Visibility="{Binding IsInUse, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding PresenceDetails}">
                <TextBlock Text="{Binding PresenceText}" FontSize="11" />
              </Border>
            </Grid>
          </DataTemplate>
        </TreeView.Resources>

        <TreeView.ItemContainerStyle>
          <!-- Compact rows: one line, ~22 px high, 16 px indent per level. -->
          <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="Row" Background="Transparent" MinHeight="22">
                      <Border x:Name="Fill" CornerRadius="3" Background="{TemplateBinding Foreground}" Opacity="0" />
                      <Border x:Name="Bar" Width="3" Height="12" CornerRadius="1.5" HorizontalAlignment="Left" Visibility="Collapsed"
                              Background="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="16" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="Expander" Style="{StaticResource TreeChevron}" Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" />
                        <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" Margin="2,0,6,0"
                                          VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                      </Grid>
                    </Grid>
                    <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="16,0,0,0" />
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="HasItems" Value="False">
                      <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                    </Trigger>
                    <Trigger Property="IsExpanded" Value="False">
                      <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                    </Trigger>
                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                      <Setter TargetName="Fill" Property="Opacity" Value="0.06" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Fill" Property="Opacity" Value="0.1" />
                      <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <Trigger Property="VirtualizingPanel.IsVirtualizing" Value="True">
                <Setter Property="ItemsPanel">
                  <Setter.Value>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </Style.Triggers>
          </Style>
        </TreeView.ItemContainerStyle>

        <TreeView.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Connect" Command="{Binding ConnectCommand}" InputGestureText="Enter" />
            <MenuItem Header="Copy password" Command="{Binding CopyPasswordCommand}" InputGestureText="Ctrl+Shift+C" />
            <MenuItem Header="Copy user" Command="{Binding CopyUserNameCommand}" />
            <MenuItem Header="Edit" Command="{Binding EditCommand}" />
            <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
            <Separator />
            <MenuItem Header="Expand all" Command="{Binding ExpandAllCommand}" />
            <MenuItem Header="Collapse all" Command="{Binding CollapseAllCommand}" />
          </ContextMenu>
        </TreeView.ContextMenu>
      </TreeView>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

      <!-- Details -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="12,0,0,0">
        <Grid>
          <TextBlock Text="Select an entry, or create one with New / Import .rdp." Opacity="0.6" Margin="0,8">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <StackPanel DataContext="{Binding Selected}">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>

            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding KindLabel}" Opacity="0.7" Margin="0,2,0,0" />

            <Border Margin="0,12,0,0" Padding="10" CornerRadius="6" Background="#22FF8C00"
                    Visibility="{Binding IsInUse, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="Active sessions" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PresenceDetails}" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
              <Button Content="Connect" Command="{Binding ConnectCommand}" Style="{DynamicResource AccentButtonStyle}"
                      Padding="20,6" Margin="0,0,8,0" ToolTip="Open in Remote Desktop (Enter / double-click)" />
              <Button Content="Copy password" Command="{Binding CopyPasswordCommand}" Margin="0,0,8,0" ToolTip="Ctrl+Shift+C" />
              <Button Content="Copy user" Command="{Binding CopyUserNameCommand}" Margin="0,0,8,0" />
              <Button Content="Edit" Command="{Binding EditCommand}" Margin="0,0,8,0" />
              <Button Content="Delete" Command="{Binding DeleteCommand}" />
            </StackPanel>

            <TextBlock Text="Host" Style="{StaticResource FieldLabel}" />
            <TextBlock Text="{Binding Model.Host, TargetNullValue='—'}" />
            <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
            <TextBlock Text="{Binding Model.Port}" />
            <TextBlock Text="User" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Model.QualifiedUserName, Mode=OneWay, TargetNullValue='—'}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" />
            <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
            <TextBlock>
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="Not stored" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasPassword}" Value="True">
                      <Setter Property="Text" Value="•••••••• (encrypted)" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="Folder" Style="{StaticResource FieldLabel}" />
            <TextBlock Text="{Binding GroupName}" />
            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Model.Notes, Mode=OneWay, TargetNullValue='—'}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" />
            <TextBlock Style="{StaticResource FieldLabel}" FontSize="11">
              <Run Text="Last changed by" />
              <Run Text="{Binding Model.UpdatedBy, Mode=OneWay, TargetNullValue='—'}" />
              <Run Text="·" />
              <Run Text="{Binding Model.UpdatedUtc.LocalDateTime, Mode=OneWay, StringFormat='g'}" />
            </TextBlock>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
