<!-- Harbor design tokens that do not depend on light/dark: type, sizes and shared text styles.
     Neutral colours (text, fills, strokes, accent) come from the built-in Fluent theme keys
     (TextFillColor*, CardBackgroundFillColor*, AccentFillColor*, ...); Harbor's own colours are in
     Colors.Light.xaml / Colors.Dark.xaml. SPEC FR-08, ADR-0025 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Anything an engineer would type in a terminal (host, port, user, domain) uses the monospace font.
       Cascadia Mono ships with Windows 11; Consolas is the fallback on Windows 10. -->
  <FontFamily x:Key="Harbor.MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
  <FontFamily x:Key="Harbor.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <sys:Double x:Key="Harbor.FontSize.Caption">11</sys:Double>
  <sys:Double x:Key="Harbor.FontSize.Mono">12</sys:Double>
  <sys:Double x:Key="Harbor.FontSize.Icon">13</sys:Double>

  <!-- Tree rows stay one low line (SPEC FR-02, ADR-0017). -->
  <sys:Double x:Key="Harbor.TreeRowHeight">24</sys:Double>
  <sys:Double x:Key="Harbor.StatusDotSize">7</sys:Double>

  <Style x:Key="Harbor.Text.Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Harbor.MonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource Harbor.FontSize.Mono}" />
  </Style>
  <Style x:Key="Harbor.Text.MonoSecondary" TargetType="TextBlock" BasedOn="{StaticResource Harbor.Text.Mono}">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="Harbor.Text.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Harbor.IconFont}" />
    <Setter Property="FontSize" Value="{StaticResource Harbor.FontSize.Icon}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Harbor.Text.Error" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Harbor.ErrorTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- "In use" marker: a dot plus a name, never colour alone (SPEC FR-33). -->
  <Style x:Key="Harbor.StatusDot" TargetType="Ellipse">
    <Setter Property="Width" Value="{StaticResource Harbor.StatusDotSize}" />
    <Setter Property="Height" Value="{StaticResource Harbor.StatusDotSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource Harbor.InUseBrush}" />
  </Style>
  <Style x:Key="Harbor.Text.Presence" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Harbor.FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Harbor.InUseTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="5,0,0,0" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Main window (SPEC FR-47, ADR-0026). -->
  <GridLength x:Key="Harbor.KeyColumnWidth">96</GridLength>

  <!-- A card groups related facts in the details pane. -->
  <Style x:Key="Harbor.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,8,8,10" />
    <Setter Property="Margin" Value="0,12,0,0" />
  </Style>
  <!-- Small caps caption on top of a card ("CONNECTION"). -->
  <Style x:Key="Harbor.Text.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Harbor.FontSize.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Margin" Value="0,2,0,4" />
  </Style>
  <!-- Left column of a key/value row in a card. -->
  <Style x:Key="Harbor.Text.Key" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,5" />
  </Style>
  <!-- A keyboard shortcut shown next to the action it triggers ("F2"). -->
  <Style x:Key="Harbor.Text.KeyHint" TargetType="TextBlock" BasedOn="{StaticResource Harbor.Text.Mono}">
    <Setter Property="FontSize" Value="{StaticResource Harbor.FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,0,0,0" />
  </Style>
  <Style x:Key="Harbor.Text.Placeholder" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <!-- Toolbar and action buttons: icon + label (+ shortcut). -->
  <Style x:Key="Harbor.Button" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>
  <!-- Quiet button without a fill until hovered: icon-only actions and copy buttons. -->
  <Style x:Key="Harbor.SubtleButton" TargetType="Button" BasedOn="{StaticResource Harbor.Button}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style x:Key="Harbor.CopyButton" TargetType="Button" BasedOn="{StaticResource Harbor.SubtleButton}">
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="FontFamily" Value="{StaticResource Harbor.IconFont}" />
    <Setter Property="FontSize" Value="{StaticResource Harbor.FontSize.Mono}" />
    <Setter Property="Content" Value="&#xE8C8;" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
