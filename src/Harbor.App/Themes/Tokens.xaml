<!-- Harbor design tokens that do not depend on light/dark: type, sizes and shared text styles.
     Neutral colours (text, fills, strokes, accent) come from the built-in Fluent theme keys
     (TextFillColor*, CardBackgroundFillColor*, AccentFillColor*, ...); Harbor's own colours are in
     Colors.Light.xaml / Colors.Dark.xaml. SPEC FR-08, ADR-0025 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Anything an engineer would type in a terminal (host, port, user, domain) uses the monospace font.
       Cascadia Mono ships with Windows 11; Consolas is the fallback on Windows 10. -->
  <FontFamily x:Key="Harbor.MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
  <FontFamily x:Key="Harbor.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <sys:Double x:Key="Harbor.FontSize.Caption">11</sys:Double>
  <sys:Double x:Key="Harbor.FontSize.Mono">12</sys:Double>
  <sys:Double x:Key="Harbor.FontSize.Icon">13</sys:Double>

  <!-- Tree rows stay one low line (SPEC FR-02, ADR-0017). -->
  <sys:Double x:Key="Harbor.TreeRowHeight">24</sys:Double>
  <sys:Double x:Key="Harbor.StatusDotSize">7</sys:Double>

  <Style x:Key="Harbor.Text.Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Harbor.MonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource Harbor.FontSize.Mono}" />
  </Style>
  <Style x:Key="Harbor.Text.MonoSecondary" TargetType="TextBlock" BasedOn="{StaticResource Harbor.Text.Mono}">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="Harbor.Text.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Harbor.IconFont}" />
    <Setter Property="FontSize" Value="{StaticResource Harbor.FontSize.Icon}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Harbor.Text.Error" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Harbor.ErrorTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- "In use" marker: a dot plus a name, never colour alone (SPEC FR-33). -->
  <Style x:Key="Harbor.StatusDot" TargetType="Ellipse">
    <Setter Property="Width" Value="{StaticResource Harbor.StatusDotSize}" />
    <Setter Property="Height" Value="{StaticResource Harbor.StatusDotSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource Harbor.InUseBrush}" />
  </Style>
  <Style x:Key="Harbor.Text.Presence" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Harbor.FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Harbor.InUseTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="5,0,0,0" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Main window (SPEC FR-47, ADR-0026). -->
  <GridLength x:Key="Harbor.KeyColumnWidth">96</GridLength>

  <!-- A card groups related facts in the details pane. -->
  <Style x:Key="Harbor.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,8,8,10" />
    <Setter Property="Margin" Value="0,12,0,0" />
  </Style>
  <!-- Small caps caption on top of a card ("CONNECTION"). -->
  <Style x:Key="Harbor.Text.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Harbor.FontSize.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Margin" Value="0,2,0,4" />
  </Style>
  <!-- Left column of a key/value row in a card. -->
  <Style x:Key="Harbor.Text.Key" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,5" />
  </Style>
  <!-- A keyboard shortcut shown next to the action it triggers ("F2"). -->
  <Style x:Key="Harbor.Text.KeyHint" TargetType="TextBlock" BasedOn="{StaticResource Harbor.Text.Mono}">
    <Setter Property="FontSize" Value="{StaticResource Harbor.FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,0,0,0" />
  </Style>
  <Style x:Key="Harbor.Text.Placeholder" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <!-- Dialogs (SPEC FR-45, FR-46, ADR-0027): the TabControl keeps its keyboard behaviour (Ctrl+Tab, Ctrl+PgDn,
       arrow keys) but its tabs are drawn as a side navigation list. -->
  <Style x:Key="Harbor.NavTab" TargetType="TabItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid x:Name="Row" MinHeight="34" Margin="0,1" Background="Transparent">
            <Border x:Name="Fill" CornerRadius="4" Background="Transparent" />
            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Visibility="Collapsed"
                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
            <Border x:Name="Focus" CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource TextFillColorPrimaryBrush}" Visibility="Collapsed" />
            <ContentPresenter ContentSource="Header" Margin="14,0,10,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Harbor.NavTabControl" TargetType="TabControl">
    <Setter Property="TabStripPlacement" Value="Left" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Harbor.NavTab}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,0,10,0">
              <StackPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" Margin="16,0,0,0"
                              KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="2" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A choice shown as a selectable card (title + description), e.g. the storage mode. -->
  <Style x:Key="Harbor.CardRadio" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Card" CornerRadius="6" BorderThickness="1" Padding="13,10"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Card" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter TargetName="Card" Property="BorderThickness" Value="2" />
              <Setter TargetName="Card" Property="Padding" Value="12,9" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Harbor.Text.CardTitle" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Harbor.Text.CardDescription" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>


  <!-- Caption buttons of the app's title bar (SPEC FR-52): 46 × 32, Segoe Fluent Icons, like the system's. -->
  <Style x:Key="Harbor.CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FontFamily" Value="{StaticResource Harbor.IconFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fill" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <!-- Maximize reports itself as HTMAXBUTTON for snap layouts; TitleBar sets Tag from non-client messages. -->
            <Trigger Property="Tag" Value="Hover">
              <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Pressed">
              <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Harbor.CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource Harbor.CaptionButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fill" Background="{TemplateBinding Background}">
            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Harbor.CaptionCloseHoverBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource Harbor.CaptionCloseForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Harbor.CaptionClosePressedBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource Harbor.CaptionCloseForegroundBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
