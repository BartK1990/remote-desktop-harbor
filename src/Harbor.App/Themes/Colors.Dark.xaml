<!-- Harbor's own colours for the dark theme. Every key here must also be in Colors.Light.xaml.
     Text colours reach 4.5:1 on the Fluent dark backgrounds, marks (dots) 3:1. SPEC FR-08, ADR-0025 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Harbor.InUseBrush" Color="#F5A524" />
  <SolidColorBrush x:Key="Harbor.InUseTextBrush" Color="#F7C978" />
  <SolidColorBrush x:Key="Harbor.InUseBackgroundBrush" Color="#3A2F1C" />
  <SolidColorBrush x:Key="Harbor.OnlineBrush" Color="#6CCB5F" />
  <SolidColorBrush x:Key="Harbor.OfflineTextBrush" Color="#FFA66B" />
  <SolidColorBrush x:Key="Harbor.ErrorTextBrush" Color="#FF99A4" />
  <!-- Quick connect palette (SPEC FR-48): dims the window behind an opaque panel. -->
  <SolidColorBrush x:Key="Harbor.ScrimBrush" Color="#99000000" />
  <SolidColorBrush x:Key="Harbor.PopupBackgroundBrush" Color="#2C2C2C" />
  <!-- Environment tags (SPEC FR-49): text reaches 4.5:1 on its tag background. -->
  <SolidColorBrush x:Key="Harbor.Env.Production.BackgroundBrush" Color="#4A1E22" />
  <SolidColorBrush x:Key="Harbor.Env.Production.ForegroundBrush" Color="#FFA3A8" />
  <SolidColorBrush x:Key="Harbor.Env.Staging.BackgroundBrush" Color="#45351A" />
  <SolidColorBrush x:Key="Harbor.Env.Staging.ForegroundBrush" Color="#FFD27A" />
  <SolidColorBrush x:Key="Harbor.Env.Test.BackgroundBrush" Color="#1F3348" />
  <SolidColorBrush x:Key="Harbor.Env.Test.ForegroundBrush" Color="#A9D0FF" />
  <SolidColorBrush x:Key="Harbor.Env.Development.BackgroundBrush" Color="#173A2B" />
  <SolidColorBrush x:Key="Harbor.Env.Development.ForegroundBrush" Color="#7EE2B0" />
  <SolidColorBrush x:Key="Harbor.Env.Lab.BackgroundBrush" Color="#35284A" />
  <SolidColorBrush x:Key="Harbor.Env.Lab.ForegroundBrush" Color="#D3B8FF" />
</ResourceDictionary>
