<!-- Harbor's own colours for the dark theme. Every key here must also be in Colors.Light.xaml.
     Text colours reach 4.5:1 on the Fluent dark backgrounds, marks (dots) 3:1. SPEC FR-08, ADR-0025 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Harbor.InUseBrush" Color="#F5A524" />
  <SolidColorBrush x:Key="Harbor.InUseTextBrush" Color="#F7C978" />
  <SolidColorBrush x:Key="Harbor.InUseBackgroundBrush" Color="#3A2F1C" />
  <SolidColorBrush x:Key="Harbor.OnlineBrush" Color="#6CCB5F" />
  <SolidColorBrush x:Key="Harbor.OfflineTextBrush" Color="#FFA66B" />
  <SolidColorBrush x:Key="Harbor.ErrorTextBrush" Color="#FF99A4" />
</ResourceDictionary>
